<?xml version="1.0" encoding="utf-8"?>

<!--
    Each button targets its own hostname, so that whatever blocks (or fails to block) a request is
    unambiguously the feature that button demonstrates, rather than another button's config or the
    platform defaults leaking across. Only the hostnames below have any config at all.

    The "untrusted root" hosts below are issued by testserver.host's own CA, trusted here via
    @raw/testserver_root. The Certificate Transparency buttons instead use publicly trusted
    (Google Trust Services) hosts, as CT only exists for public CAs.
-->
<network-security-config>

    <!-- Unpinned, plain HTTP & Flutter requests. No pinning, no custom anchors: the baseline. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">testserver.host</domain>
    </domain-config>

    <!-- Android's own config-defined pinning. Nothing else uses this host. -->
    <domain-config>
        <domain includeSubdomains="false">rsa2048--untrusted-root.testserver.host</domain>
        <pin-set>
            <pin digest="SHA-256">SOCynZ/Y0dEFXgzk6JBT75LF3JhnwWGNJ4SMOmU8CIY=</pin>

            <!-- TrustKit rejects the config if we use only one pin, so we add a dud: -->
            <pin digest="SHA-256">ABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFA</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="@raw/testserver_root" />
        </trust-anchors>
    </domain-config>

    <!-- TrustKit's reimplementation of the same idea, on its own host to keep the two separable. -->
    <domain-config>
        <domain includeSubdomains="false">rsa4096--untrusted-root.testserver.host</domain>
        <pin-set>
            <pin digest="SHA-256">SOCynZ/Y0dEFXgzk6JBT75LF3JhnwWGNJ4SMOmU8CIY=</pin>
            <pin digest="SHA-256">ABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFA</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="@raw/testserver_root" />
        </trust-anchors>
        <trustkit-config enforcePinning="true">
            <report-uri>http://trustkit-report-url.test</report-uri>
        </trustkit-config>
    </domain-config>

    <!--
        Pinning done manually in code (context/OkHttp/Volley/raw socket). Deliberately no pin-set,
        and system certificates are trusted alongside our own CA, so that the platform will happily
        complete any connection an interceptor offers. That leaves the app's own pinning code as
        the only thing that can block these requests, which is the point of these buttons - without
        the system anchors, an interception CA would be rejected during chain validation before
        OkHttp's CertificatePinner ever ran.
    -->
    <domain-config>
        <domain includeSubdomains="false">rsa8192--untrusted-root.testserver.host</domain>
        <trust-anchors>
            <certificates src="@raw/testserver_root" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Appmattus's global CT provider, which for WebView needs the anchors configured here too. -->
    <domain-config>
        <domain includeSubdomains="false">tls-v1-3--tls-v1-2.testserver.host</domain>
        <pin-set>
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
            <pin digest="SHA-256">ABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFA</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="@raw/gts_root_r1" />
        </trust-anchors>
    </domain-config>

</network-security-config>
